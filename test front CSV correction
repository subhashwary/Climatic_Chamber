    <script>
const BASE_URL = "http://127.0.0.1:5000";

let sensorChart;
let temperatureChart;

let isRunning = false;

let samplingRateSec = 1;
let dataInterval = null;

// 🔴 FREEZE DETECTION
let lastValues = [null, null, null, null, null];
let freezeCount = [0, 0, 0, 0, 0];
const FREEZE_LIMIT = 5;

// ---------------- CHART SETUP ----------------
window.onload = function () {

    // PRESSURE CHART
    const ctx = document.getElementById('sensorChart').getContext('2d');
    sensorChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { label: 'Sensor 1', borderColor: 'red', data: [], fill: false },
                { label: 'Sensor 2', borderColor: 'blue', data: [], fill: false },
                { label: 'Sensor 3', borderColor: 'green', data: [], fill: false },
                { label: 'Sensor 4', borderColor: 'orange', data: [], fill: false },
                { label: 'Sensor 5', borderColor: 'purple', data: [], fill: false }
            ]
        },
        options: {
            responsive: true,
            animation: false,
            elements: {
                point: {
                    radius: 0
                }
            },
            scales: {
                x: { title: { display: true, text: "Time (HH:MM:SS)" } },
                y: { title: { display: true, text: "Pressure (Psi)" } }
            }
        }
    });

    // TEMPERATURE CHART
    const tctx = document.getElementById('temperatureChart').getContext('2d');
    temperatureChart = new Chart(tctx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { label: 'Sensor 1', borderColor: 'red', data: [], fill: false },
                { label: 'Sensor 2', borderColor: 'blue', data: [], fill: false },
                { label: 'Sensor 3', borderColor: 'green', data: [], fill: false },
                { label: 'Sensor 4', borderColor: 'orange', data: [], fill: false },
                { label: 'Sensor 5', borderColor: 'purple', data: [], fill: false }
            ]
        },
        options: {
            responsive: true,
            animation: false,
            elements: {
                point: {
                    radius: 0
                }
            },
            scales: {
                x: { title: { display: true, text: "Time (HH:MM:SS)" } },
                y: { title: { display: true, text: "Temperature (°C)" } }
            }
        }
    });
    
    applySamplingRate();
};

// ---------------- FETCH DATA ----------------
async function fetchData() {
    try {
        const res = await fetch(`${BASE_URL}/data`);
        const data = await res.json();

        // 🟢 AUTO RECONNECT DETECTION (USB plugged back)
        // 🟢 AUTO CONNECT (USB plugged back properly)
        if (data.status === "live" && isRunning) {
            document.getElementById("pressure").innerText = "CONNECTED";
            document.getElementById("temperature").innerText = "CONNECTED";

            document.getElementById("pressure").style.color = "green";
            document.getElementById("temperature").style.color = "green";
        }

        // 🔴 HANDLE DISCONNECTED / NO SIGNAL
        if (data.status === "disconnected" || data.status === "no_data") {

            let msg = (data.status === "disconnected") ? "DISCONNECTED" : "NO SIGNAL";

            document.getElementById("pressure").innerText = msg;
            document.getElementById("temperature").innerText = msg;

            document.getElementById("pressure").style.color = "red";
            document.getElementById("temperature").style.color = "red";

            return;
        }

        // 🟢 AUTO CONNECT DETECTION (when data resumes after unplug)
        if (data.status === "live" && !isRunning) {
            document.getElementById("pressure").innerText = data.pressure;
            document.getElementById("temperature").innerText = data.temperature;

            document.getElementById("pressure").style.color = "green";
            document.getElementById("temperature").style.color = "green";
        } else {
            document.getElementById("pressure").innerText = data.pressure;
            document.getElementById("temperature").innerText = data.temperature;

            document.getElementById("pressure").style.color = "#1f2d3a";
            document.getElementById("temperature").style.color = "#1f2d3a";
        }

        let now = new Date();
        let label = now.toLocaleTimeString();

        sensorChart.data.labels.push(label);
        temperatureChart.data.labels.push(label);

        for (let i = 1; i <= 5; i++) {

            // -------- UI UPDATE --------
            let pVolt = data[`p${i}_volt`];
            let tVolt = data[`t${i}_volt`];

            document.getElementById(`p${i}_volt`).value =
                (pVolt != null) ? Number(pVolt).toFixed(3) : "";

            document.getElementById(`t${i}_volt`).value =
                (tVolt != null) ? Number(tVolt).toFixed(3) : "";

            updatePressure(i);
            updateTemperature(i);

            // -------- CALCULATIONS --------
            let psi = parseFloat(data[`p${i}_psi`]);
            if (isNaN(psi)) psi = null;

            let temp = parseFloat(data[`t${i}_temp`]);

            if (isNaN(temp)) {
                let tVoltVal = parseFloat(tVolt);
                temp = isNaN(tVoltVal) ? null : (8 * tVoltVal) + 10;
            }

            // -------- GRAPH UPDATE --------
            sensorChart.data.datasets[i - 1].data.push(psi);
            temperatureChart.data.datasets[i - 1].data.push(temp);

            // -------- FREEZE DETECTION --------
            if (psi !== null) {
                if (psi === lastValues[i - 1]) {
                    freezeCount[i - 1]++;
                } else {
                    freezeCount[i - 1] = 0;
                }

                lastValues[i - 1] = psi;

                if (freezeCount[i - 1] > FREEZE_LIMIT) {
                    sensorChart.data.datasets[i - 1].borderDash = [5, 5];
                } else {
                    sensorChart.data.datasets[i - 1].borderDash = [];
                }
            }
        }

        // LIMIT DATA
        const MAX_POINTS = Math.floor(86400 / samplingRateSec);

        if (sensorChart.data.labels.length > MAX_POINTS) {
            sensorChart.data.labels.shift();
            temperatureChart.data.labels.shift();

            sensorChart.data.datasets.forEach(ds => ds.data.shift());
            temperatureChart.data.datasets.forEach(ds => ds.data.shift());
        }

        // UPDATE
        sensorChart.update();
        temperatureChart.update();

    } catch (err) {
    console.log("Fetch error:", err);

    // 🔴 USB unplug / backend unreachable → mark as DISCONNECTED
    document.getElementById("pressure").innerText = "DISCONNECTED";
    document.getElementById("temperature").innerText = "DISCONNECTED";

    document.getElementById("pressure").style.color = "red";
    document.getElementById("temperature").style.color = "red";
}
}

function toggleSensor(event, index) {
    const checked = event.target.checked;

    sensorChart.data.datasets[index].hidden = !checked;
    temperatureChart.data.datasets[index].hidden = !checked;

    sensorChart.update();
    temperatureChart.update();
}

// ---------------- UPDATE FUNCTIONS ----------------
function updatePressure(sensor) {
    let volt = parseFloat(document.getElementById(`p${sensor}_volt`).value);

    if (isNaN(volt)) {
        document.getElementById(`p${sensor}_psi`).innerText = "";
        return;
    }

    let psi = (4 * volt) + 5;
    document.getElementById(`p${sensor}_psi`).innerText = psi.toFixed(2);
}

function updateTemperature(sensor) {
    let volt = parseFloat(document.getElementById(`t${sensor}_volt`).value);

    if (isNaN(volt)) {
        document.getElementById(`t${sensor}_temp`).innerText = "";
        return;
    }

    let temp = (8 * volt) + 10;
    document.getElementById(`t${sensor}_temp`).innerText = temp.toFixed(2);
}

// ---------------- CONTROL ----------------
async function startDevice() {
    isRunning = true;
    await fetch(`${BASE_URL}/start`, { method: "POST" });

    document.getElementById("pressure").innerText = "STARTED";
    document.getElementById("temperature").innerText = "STARTED";

    applySamplingRate();
    setActiveButton("startBtn");
}

async function stopDevice() {
    if (dataInterval) {
    clearInterval(dataInterval);
    dataInterval = null;
}
    await fetch(`${BASE_URL}/stop`, { method: "POST" });

    document.getElementById("pressure").innerText = "STOPPED";
    document.getElementById("temperature").innerText = "STOPPED";

    document.getElementById("pressure").style.color = "red";
    document.getElementById("temperature").style.color = "red";

    isRunning = false;
    setActiveButton("stopBtn");
}

function resetDevice() {

    // stop fetching
    if (dataInterval) {
    clearInterval(dataInterval);
    dataInterval = null;
}
    isRunning = false;

    // reset UI text
    document.getElementById("pressure").innerText = "RESET";
    document.getElementById("temperature").innerText = "RESET";

    // clear charts completely
    sensorChart.data.labels = [];
    temperatureChart.data.labels = [];

    sensorChart.data.datasets.forEach(ds => ds.data = []);
    temperatureChart.data.datasets.forEach(ds => ds.data = []);

    sensorChart.update();
    temperatureChart.update();

    // reset freeze detection
    lastValues = [null, null, null, null, null];
    freezeCount = [0, 0, 0, 0, 0];

    // clear input + output boxes
    for (let i = 1; i <= 5; i++) {
        document.getElementById(`p${i}_volt`).value = "";
        document.getElementById(`p${i}_psi`).innerText = "";

        document.getElementById(`t${i}_volt`).value = "";
        document.getElementById(`t${i}_temp`).innerText = "";
    }
    // ✅ set active AFTER loop
    setActiveButton("resetBtn");
}

// ---------------- EXPORT ----------------
function exportCSV() {
    let csv = "Time,Sensor1,Sensor2,Sensor3,Sensor4,Sensor5\n";

    let labels = sensorChart.data.labels;
    let datasets = sensorChart.data.datasets;

    for (let i = 0; i < labels.length; i++) {
        let row = [labels[i]];
        datasets.forEach(ds => row.push(ds.data[i] ?? ""));
        csv += row.join(",") + "\n";
    }

    let blob = new Blob([csv], { type: "text/csv" });
    let url = URL.createObjectURL(blob);

    let a = document.createElement("a");
    a.href = url;
    a.download = "sensor_data.csv";
    a.click();

    URL.revokeObjectURL(url);
}

// ---------------- SAMPLING CONTROL ----------------
function applySamplingRate() {

    // stop existing loop
    if (dataInterval) {
        clearInterval(dataInterval);
    }

    // restart only if system is running
    if (isRunning) {
        dataInterval = setInterval(fetchData, samplingRateSec * 1000);
    }
}

// ---------------- HELPER FUNCTIONS ----------------
function setActiveButton(activeId) {
    const buttons = ["startBtn", "stopBtn", "resetBtn"];

    buttons.forEach(id => {
        document.getElementById(id).classList.remove("active-btn");
    });

    document.getElementById(activeId).classList.add("active-btn");
}

function changeSamplingRate() {
    samplingRateSec = parseInt(document.getElementById("samplingRate").value);
    applySamplingRate();
}

// ---------------- CONNECT ----------------
async function connectDevice() {
    try {
        const port = document.getElementById("comPort").value;
        const baud = document.getElementById("baudRate").value;

        const res = await fetch(`${BASE_URL}/connect`, {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({
                com_port: port,
                baud_rate: baud
            })
        });

        const data = await res.json();

        if (data.status === "connected") {
            alert("Device Connected ✅");

            document.getElementById("pressure").innerText = "CONNECTED";
            document.getElementById("temperature").innerText = "CONNECTED";

            document.getElementById("pressure").style.color = "green";
            document.getElementById("temperature").style.color = "green";

            isRunning = true;
            applySamplingRate();
        } else {
            alert("❌ " + data.message);
        }

    } catch {
        alert("Backend not reachable ❌");
    }
}

