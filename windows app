    <script>
const BASE_URL = "http://127.0.0.1:5000";

let sensorChart;
let temperatureChart;

let displayCounter = 0;

let isRunning = false;

let samplingRateSec = 1;
let dataInterval = null;

let fetchInterval = null;
let lastSampleId = -1;

let lastPlottedSampleId = -1;

// ---------------- CHART SETUP ----------------
window.onload = function () {

    // PRESSURE CHART
    const ctx = document.getElementById('sensorChart').getContext('2d');
    sensorChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [],
            datasets: [
                { label: 'Sensor 1', borderColor: '#e41a1c', data: [], fill: false },
                { label: 'Sensor 2', borderColor: '#377eb8', data: [], fill: false },
                { label: 'Sensor 3', borderColor: '#4daf4a', data: [], fill: false },
                { label: 'Sensor 4', borderColor: '#ff7f00', data: [], fill: false },
                { label: 'Sensor 5', borderColor: '#984ea3', data: [], fill: false }
            ]
        },
        options: {
        responsive: true,
        animation: false,

        elements: {
            line: {
                tension: 0.2,
                borderWidth: 3   // thicker lines
            },
            point: {
                radius: 5,       // bigger dots
                hoverRadius: 7
            }
        },

        plugins: {
            legend: {
                position: 'top'
            },
            decimation: {
                enabled: true,
                algorithm: 'lttb',
                samples: 500
            }
        },

        scales: {
            x: {
                title: {
                    display: true,
                    text: "Sample Number"
                },
                grid: {
                    display: true
                }
            },
            y: {
                title: {
                    display: true,
                    text: "Pressure (Psi)"
                },
                grid: {
                    display: true
                },

                // 🔥 IMPORTANT: match tight range like your image
                ticks: {
                    stepSize: 2,
                    callback: val => val + " psi"
                }
            }
        }
    }
    });

    // TEMPERATURE CHART
    const tctx = document.getElementById('temperatureChart').getContext('2d');
    temperatureChart = new Chart(tctx, {
    type: 'line',
    data: {
        labels: [],
        datasets: [
            { label: 'Sensor 1', borderColor: '#e41a1c', data: [], fill: false },
            { label: 'Sensor 2', borderColor: '#377eb8', data: [], fill: false },
            { label: 'Sensor 3', borderColor: '#4daf4a', data: [], fill: false },
            { label: 'Sensor 4', borderColor: '#ff7f00', data: [], fill: false },
            { label: 'Sensor 5', borderColor: '#984ea3', data: [], fill: false }
        ]
    },
    options: {
        responsive: true,
        animation: false,
        elements: {
            line: { tension: 0.2, borderWidth: 3 },
            point: { radius: 5, hoverRadius: 7 }
        },
        plugins: {
            legend: { position: 'top' },
            decimation: {
                enabled: true,
                algorithm: 'lttb',
                samples: 500
            }
        },
        scales: {
            x: {
                title: { display: true, text: "Sample Number" }
            },
            y: {
                title: {
                    display: true,
                    text: "Temperature (°C)"
                },

                // 🔥 FIXED RANGE (same style as pressure)

                ticks: {
                    stepSize: 5,
                    callback: val => val + "°C"  // smooth readable steps
                },

                grid: {
                    display: true
                }
            }
        }
    }
});  // ✅ REQUIRED
    
    applySamplingRate();
    restartFetchLoop();
};

// ---------------- FETCH DATA ----------------
async function fetchData() {
    try {
        const res = await fetch(`${BASE_URL}/data`);
        const data = await res.json();

        // 🟢 AUTO RECONNECT DETECTION (USB plugged back)
        // 🟢 AUTO CONNECT (USB plugged back properly)
        if (data.status === "live" && isRunning) {
            document.getElementById("pressure").innerText = "CONNECTED";
            document.getElementById("temperature").innerText = "CONNECTED";

            document.getElementById("pressure").style.color = "green";
            document.getElementById("temperature").style.color = "green";
        }

        // 🔴 HANDLE DISCONNECTED / NO SIGNAL
        if (data.status === "disconnected" || data.status === "no_data") {

            let msg = (data.status === "disconnected") ? "DISCONNECTED" : "NO SIGNAL";

            document.getElementById("pressure").innerText = msg;
            document.getElementById("temperature").innerText = msg;

            document.getElementById("pressure").style.color = "red";
            document.getElementById("temperature").style.color = "red";

            return;
        }

        if (data.status === "stopped") {
            document.getElementById("pressure").innerText = "STOPPED";
            document.getElementById("temperature").innerText = "STOPPED";

            document.getElementById("pressure").style.color = "red";
            document.getElementById("temperature").style.color = "red";
        }
        else if (data.status === "live") {
            document.getElementById("pressure").innerText = data.pressure;
            document.getElementById("temperature").innerText = data.temperature;

            document.getElementById("pressure").style.color = "#1f2d3a";
            document.getElementById("temperature").style.color = "#1f2d3a";
        }

        for (let i = 1; i <= 5; i++) {

            // -------- UI UPDATE --------
            let pVolt = data[`p${i}_volt`];
            let tVolt = data[`t${i}_volt`];

            document.getElementById(`p${i}_volt`).value =
                (pVolt != null) ? Number(pVolt).toFixed(3) : "";

            document.getElementById(`t${i}_volt`).value =
                (tVolt != null) ? Number(tVolt).toFixed(3) : "";

            updatePressure(i);
            updateTemperature(i);
        }

        // -------- SAMPLE-SYNC GRAPH ENGINE (CSV = GRAPH) --------
        if (isRunning && data.sample_id !== -1 && data.sample_id !== lastPlottedSampleId) {

        lastPlottedSampleId = data.sample_id;

        displayCounter++;
        let label = displayCounter;

        sensorChart.data.labels.push(label);
        temperatureChart.data.labels.push(label);

        for (let i = 1; i <= 5; i++) {

            let psi = parseFloat(data[`p${i}_psi`]);
            if (isNaN(psi)) psi = null;

            let temp = parseFloat(data[`t${i}_temp`]);
            if (isNaN(temp)) temp = null;

            sensorChart.data.datasets[i - 1].data.push(psi);
            temperatureChart.data.datasets[i - 1].data.push(temp);
        }

        // keep chart memory bounded
        const MAX_POINTS = 10800; // 3 hours @ 1 sec

        if (sensorChart.data.labels.length > MAX_POINTS) {
            sensorChart.data.labels.shift();
            temperatureChart.data.labels.shift();

            sensorChart.data.datasets.forEach(ds => ds.data.shift());
            temperatureChart.data.datasets.forEach(ds => ds.data.shift());
        }

        autoScaleYAxis(sensorChart);
        autoScaleYAxis(temperatureChart);

        sensorChart.update('none');
        temperatureChart.update('none');
    }

    } catch (err) {
    console.log("Fetch error:", err);

    // 🔴 USB unplug / backend unreachable → mark as DISCONNECTED
    document.getElementById("pressure").innerText = "DISCONNECTED";
    document.getElementById("temperature").innerText = "DISCONNECTED";

    document.getElementById("pressure").style.color = "red";
    document.getElementById("temperature").style.color = "red";
}
}

function toggleSensor(index, event) {
    const checked = event.target.checked;

    sensorChart.data.datasets[index].hidden = !checked;
    temperatureChart.data.datasets[index].hidden = !checked;

    sensorChart.update();
    temperatureChart.update();
}

// ---------------- UPDATE FUNCTIONS ----------------
function updatePressure(sensor) {
    let volt = parseFloat(document.getElementById(`p${sensor}_volt`).value);

    if (isNaN(volt)) {
        document.getElementById(`p${sensor}_psi`).innerText = "";
        return;
    }

    let psi = (4 * volt) + 5;
    document.getElementById(`p${sensor}_psi`).innerText = psi.toFixed(2);
}

function updateTemperature(sensor) {
    let volt = parseFloat(document.getElementById(`t${sensor}_volt`).value);

    if (isNaN(volt)) {
        document.getElementById(`t${sensor}_temp`).innerText = "";
        return;
    }

    let temp = (8 * volt) + 10;
