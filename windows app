class Multimeter(SCPIInstrument):

    def idn(self):
        return self.query("*IDN?")

    def measure_voltage(self):

        try:
            # Set DC Voltage mode
            self.write("CONF:VOLT:DC")

            time.sleep(0.5)

            # Request reading
            response = self.query("READ?")

            print("RAW DMM RESPONSE:", response)

            # Clean response
            response = response.replace("VDC", "").strip()

            return float(response)

        except Exception as e:
            print("Voltage measurement error:", e)
            return 0.0
