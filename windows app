import threading
import time
import webview
from app import app

def run_flask():
    app.run(port=5000)

# Start Flask in background
threading.Thread(target=run_flask, daemon=True).start()

# 🔥 WAIT for Flask to start
time.sleep(2)

# Open desktop window
webview.create_window("Sensor App", "http://127.0.0.1:5000")
webview.start()
