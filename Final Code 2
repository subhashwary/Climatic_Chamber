<!DOCTYPE html>
<html>
<head>
<title>Sensor Dashboard</title>

<style>
body {
    font-family: Arial;
    margin: 20px;
    background-color: #f4f7fb;
}

.header {
    display: flex;
    justify-content: space-between;
    background-color: #d9e6f2;
    padding: 10px;
}

.title-container {
    text-align: center;
}

.title { font-size: 28px; font-weight: bold; }
.subtitle { font-size: 18px; }

.sensor-container {
    display: flex;
    gap: 40px;
    margin-top: 30px;
    justify-content: center;
}

.sensor-box {
    border: 2px solid #2c3e50;
    padding: 15px;
    width: 40%;
    background: white;
}

.sensor-title {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 10px;
}

.grid {
    display: grid;
    grid-template-columns: 100px 120px 120px;
    gap: 6px;
    align-items: center;
}

.grid input, .grid div {
    border: 1px solid #333;
    padding: 5px;
    text-align: center;
}

.top-buttons {
    text-align: center;
    margin-top: 20px;
}

button {
    padding: 10px;
    margin: 5px;
    cursor: pointer;
}
</style>
</head>

<body>

<div class="header">
    <div>CeNSE</div>
    <div class="title-container">
        <div class="title">Sensor Dashboard</div>
        <div class="subtitle">Realtime Monitoring</div>
    </div>
    <div>IISc</div>
</div>

<div style="margin-top:20px;">
    COM: <input id="comPort" placeholder="COM6">
    Baud: <input id="baudRate" placeholder="9600">
    <button onclick="connectDevice()">CONNECT</button>
</div>

<div class="sensor-container">

<!-- PRESSURE -->
<div class="sensor-box">
<div class="sensor-title">Pressure</div>

<div class="grid">
<div></div><b>Volt</b><b>PSI</b>

<div>Sensor1</div><input id="p1_volt"><div id="p1_psi"></div>
<div>Sensor2</div><input id="p2_volt"><div id="p2_psi"></div>
<div>Sensor3</div><input id="p3_volt"><div id="p3_psi"></div>
<div>Sensor4</div><input id="p4_volt"><div id="p4_psi"></div>
<div>Sensor5</div><input id="p5_volt"><div id="p5_psi"></div>
</div>
</div>

<!-- TEMPERATURE -->
<div class="sensor-box">
<div class="sensor-title">Temperature</div>

<div class="grid">
<div></div><b>Volt</b><b>°C</b>

<div>Sensor1</div><input id="t1_volt"><div id="t1_temp"></div>
<div>Sensor2</div><input id="t2_volt"><div id="t2_temp"></div>
<div>Sensor3</div><input id="t3_volt"><div id="t3_temp"></div>
<div>Sensor4</div><input id="t4_volt"><div id="t4_temp"></div>
<div>Sensor5</div><input id="t5_volt"><div id="t5_temp"></div>
</div>
</div>

</div>

<div class="top-buttons">
<button onclick="startDevice()">START</button>
<button onclick="stopDevice()">STOP</button>
</div>

<script>
const BASE_URL = "http://127.0.0.1:5000";

async function connectDevice(){
    const port = document.getElementById("comPort").value;
    const baud = document.getElementById("baudRate").value;

    const res = await fetch(`${BASE_URL}/connect`,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({com_port:port, baud_rate:baud})
    });

    const data = await res.json();
    alert(data.status);
}

async function fetchData(){
    const res = await fetch(`${BASE_URL}/data`);
    const data = await res.json();

    if(data.status !== "live") return;

    for(let i=1;i<=5;i++){
        document.getElementById(`p${i}_volt`).value = data[`p${i}_volt`] ?? "";
        document.getElementById(`p${i}_psi`).innerText = data[`p${i}_psi`] ?? "";

        document.getElementById(`t${i}_volt`).value = data[`t${i}_volt`] ?? "";
        document.getElementById(`t${i}_temp`).innerText = data[`t${i}_temp`] ?? "";
    }
}

function startDevice(){
    window.loop = setInterval(fetchData,500);
}

function stopDevice(){
    clearInterval(window.loop);
}
</script>

</body>
</html>
