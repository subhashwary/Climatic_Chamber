<!DOCTYPE html>
<html>
<head>
    <title>Sensor Dashboard</title>

    <style>
    body {
        font-family: Arial;
        margin: 20px;
        background-color: #f4f7fb;
    }

    .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: #d9e6f2;
        padding: 10px;
        border-radius: 6px;
    }

    .header img { height: 60px; }

    .title-container {
        flex-grow: 1;
        text-align: center;
    }

    .title { font-size: 44px; font-weight: bold; }
    .subtitle { font-size: 28px; font-weight: bold; }

    .sensor-container {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 25px;
    }

    .sensor-box {
        width: 40%;
        padding: 12px;
        background: #fff;
        border: 2px solid #2c3e50;
    }

    .sensor-title {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .panel-buttons {
        display: grid;
        grid-template-columns: 120px 140px 140px;
        gap: 6px;
    }

    .btn-box {
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #2c3e50;
        font-weight: bold;
        font-size: 16px;
    }

    input.btn-box {
        text-align: center;
    }

    .sensor-label {
        text-align: right;
        padding-right: 6px;
        font-weight: bold;
    }

    .connection-box {
        position: absolute;
        top: 160px;
        right: 20px;
        background: #fff;
        padding: 10px;
        border: 2px solid #2c3e50;
    }

    .top-buttons {
        text-align: center;
        margin-top: 20px;
    }

    button {
        width: 90px;
        height: 40px;
        margin: 5px;
        cursor: pointer;
    }
    </style>
</head>

<body>

<!-- HEADER -->
<div class="header">
    <img src="images/cense-logoo.png">

    <div class="title-container">
        <div class="title">CeNSE</div>
        <div class="subtitle">IISc Bangalore</div>
    </div>

    <img src="images/IISc_Master_Seal_Black.jpg">
</div>

<!-- CONNECTION -->
<div class="connection-box">
    <div>
        COM: <input type="text" id="comPort" placeholder="COM6">
    </div>
    <div>
        Baud: <input type="number" id="baudRate" placeholder="9600">
    </div>
    <button onclick="connectDevice()">CONNECT</button>
</div>

<!-- MAIN -->
<div class="sensor-container">

    <!-- LEFT PANEL -->
    <div class="sensor-box">

        <!-- RAKE + TIMESTAMP -->
        <div style="display:flex; justify-content:space-between; margin-bottom:10px;">
            <div>
                <b>RAKE No:</b>
                <input type="text" id="rakeNo" style="width:100px;">
            </div>
            <div id="timestamp"></div>
        </div>

        <div class="sensor-title">Pressure Sensor</div>

        <div class="panel-buttons">

            <div></div><b>Volt</b><b>PSI</b>

            <!-- sensors -->
            <script>
            for (let i=1;i<=5;i++){
                document.write(`
                <div class="sensor-label">S${i}</div>
                <input class="btn-box" id="p${i}_volt">
                <div class="btn-box" id="p${i}_psi"></div>
                `);
            }
            </script>

        </div>
    </div>

    <!-- RIGHT PANEL -->
    <div class="sensor-box">
        <div class="sensor-title">Temperature</div>

        <div class="panel-buttons">

            <div></div><b>Volt</b><b>°C</b>

            <script>
            for (let i=1;i<=5;i++){
                document.write(`
                <div class="sensor-label">S${i}</div>
                <input class="btn-box" id="t${i}_volt">
                <div class="btn-box" id="t${i}_temp"></div>
                `);
            }
            </script>

        </div>
    </div>

</div>

<!-- BUTTONS -->
<div class="top-buttons">
    <button onclick="startDevice()">START</button>
    <button onclick="stopDevice()">STOP</button>
</div>

<script>
const BASE_URL = "http://127.0.0.1:5000";

let csvContent = "timestamp,rake_no,p1_v,p1_psi,...\n";

// timestamp
function getTimestamp(){
    return new Date().toISOString();
}

// CSV save
function downloadCSV(row){
    csvContent += row + "\n";
}

// FETCH DATA
async function fetchData(){
    try{
        const res = await fetch(`${BASE_URL}/data`);
        const data = await res.json();

        const ts = getTimestamp();
        document.getElementById("timestamp").innerText = ts;

        const rake = document.getElementById("rakeNo").value || "NA";

        let row = [ts, rake];

        for(let i=1;i<=5;i++){

            let v = parseFloat(data[`p${i}_volt`]) || 0;
            let p = parseFloat(data[`p${i}_psi`]) || 0;

            document.getElementById(`p${i}_volt`).value = v.toFixed(3);
            document.getElementById(`p${i}_psi`).innerText = p.toFixed(3);

            row.push(v,p);
        }

        downloadCSV(row.join(","));

    }catch(e){
        console.log(e);
    }
}

// CONTROL
function startDevice(){
    window.loop = setInterval(fetchData,500);
}

function stopDevice(){
    clearInterval(window.loop);

    // download once
    const blob = new Blob([csvContent]);
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "data.csv";
    a.click();
}

// CONNECT
async function connectDevice(){
    const port = document.getElementById("comPort").value;
    const baud = document.getElementById("baudRate").value;

    await fetch(`${BASE_URL}/connect`,{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({com_port:port, baud_rate:baud})
    });

    alert("Connected");
}
</script>

</body>
</html>
