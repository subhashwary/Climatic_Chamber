def measure_voltage(self):

    try:
        response = self.query("MEAS:VOLT:DC?")

        print("RAW RESPONSE:", response)

        # Empty response protection
        if not response:
            return 0.0

        value = response.split(',')[0].strip()

        return float(value)

    except Exception as e:

        print("Measurement Error:", e)

        return 0.0
