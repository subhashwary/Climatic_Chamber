// ============================================
// LOAD AVAILABLE COM PORTS
// ============================================

function loadPorts() {

    fetch('/ports')
    .then(res => res.json())
    .then(ports => {

        const select = document.getElementById('comPortSelect');

        select.innerHTML = '';

        ports.forEach(port => {

            const option = document.createElement('option');

            option.value = port.device;

            option.text =
                `${port.device} - ${port.description}`;

            select.appendChild(option);
        });
    });
}

loadPorts();
