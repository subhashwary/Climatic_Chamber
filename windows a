.dmm-display {
    width: 180px;
    height: 55px;

    background: black;
    color: #00ff66;

    font-size: 32px;
    font-family: "Courier New", monospace;
    font-weight: bold;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 8px;
    border: 3px solid #1f2937;

    letter-spacing: 2px;

    box-shadow:
        inset 0 0 10px rgba(0,255,100,0.3),
        0 0 8px rgba(0,255,100,0.2);
}
