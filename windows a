// ============================================
// CONNECT DMM
// ============================================

function connectDMM() {

    const port =
        document.getElementById('comPortSelect').value;

    fetch('/connect_dmm', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify({
            port: port
        })

    })
    .then(res => res.json())
    .then(data => {

        if (data.status === "connected") {

            alert(
                "DMM Connected:\n" + data.id
            );

        } else {

            alert(
                "Connection Failed:\n" + data.message
            );
        }
    });
}
