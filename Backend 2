from flask import Flask, jsonify, request
from flask_cors import CORS
import serial
import time
import re

app = Flask(__name__)
CORS(app)

ser = None

# Only 5 real channels
last_values = [0.0] * 5


# ---------------- CONNECT ----------------
@app.route('/connect', methods=['POST'])
def connect():
    global ser

    data = request.json

    try:
        port = data.get("com_port")
        baud = int(data.get("baud_rate"))

        if not port or not baud:
            return jsonify({"status": "error", "message": "Missing COM port or baud rate"})

        if ser and ser.is_open:
            ser.close()
            time.sleep(1)

        ser = serial.Serial(port, baud, timeout=1)
        time.sleep(2)  # Arduino reset delay

        print(f"Connected to {port} at {baud}")
        return jsonify({"status": "connected"})

    except Exception as e:
        print("SERIAL ERROR:", e)
        return jsonify({"status": "error", "message": str(e)})


# ---------------- DATA ----------------
@app.route('/data')
def get_data():
    global ser, last_values

    if ser is None or not ser.is_open:
        return jsonify({
            "pressure": "Not Connected",
            **{f"p{i}_volt": "" for i in range(1, 6)},
            **{f"p{i}_psi": "" for i in range(1, 6)},
        })

    try:
        line = ser.readline().decode('utf-8', errors='ignore').strip()

        if line:
            print("RAW:", line)

        # Extract numbers from serial line
        numbers = re.findall(r"-?\d+\.?\d*", line)
        values = list(map(float, numbers))

        # ✅ STRICT: accept only exactly 5 values
        if len(values) == 5:
            alpha = 0.7  # smoother but still responsive
            for i in range(5):
                last_values[i] = alpha * last_values[i] + (1 - alpha) * values[i]

        # Always use last stable values
        values = last_values.copy()

        # ✅ Calibration / conversion (EDIT HERE if needed)
        # Example: PSI = m*V + c (currently simple scaling)
        psi_values = [v * 100 for v in values]

        # ✅ Force 3 decimal precision (as FLOAT, not string)
        volt_values = [round(v, 3) for v in values]
        psi_values = [round(p, 3) for p in psi_values]

        return jsonify({
            "pressure": "Live",

            "p1_volt": volt_values[0], "p1_psi": psi_values[0],
            "p2_volt": volt_values[1], "p2_psi": psi_values[1],
            "p3_volt": volt_values[2], "p3_psi": psi_values[2],
            "p4_volt": volt_values[3], "p4_psi": psi_values[3],
            "p5_volt": volt_values[4], "p5_psi": psi_values[4],
        })

    except Exception as e:
        print("READ ERROR:", e)

        # Return last known safe values
        return jsonify({
            "pressure": "Error",
            **{f"p{i}_volt": round(last_values[i-1], 3) for i in range(1, 6)},
            **{f"p{i}_psi": round(last_values[i-1] * 100, 3) for i in range(1, 6)},
        })


# ---------------- START ----------------
@app.route('/start', methods=['POST'])
def start():
    return jsonify({"status": "started"})


# ---------------- STOP ----------------
@app.route('/stop', methods=['POST'])
def stop():
    return jsonify({"status": "stopped"})


# ---------------- RESET ----------------
@app.route('/reset', methods=['POST'])
def reset():
    global last_values
    last_values = [0.0] * 5
    return jsonify({"status": "reset"})


# ---------------- RUN ----------------
if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5000, debug=True, use_reloader=False)
