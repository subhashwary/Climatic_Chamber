import webbrowser
from flask import Flask, jsonify, request, send_from_directory
from flask_cors import CORS
import serial
import time
import threading
import re

app = Flask(__name__)
CORS(app)

ser = None
last_values = [0.0] * 10
last_update_time = 0


@app.route('/')
def serve_ui():
    return send_from_directory('.', 'index.html')


@app.route('/connect', methods=['POST'])
def connect():
    global ser, last_values, last_update_time

    data = request.json

    try:
        port = data.get("com_port")
        baud = int(data.get("baud_rate"))

        if ser and ser.is_open:
            ser.close()

        ser = serial.Serial(port, baud, timeout=1)
        time.sleep(2)
        ser.reset_input_buffer()

        last_values = [0.0] * 10
        last_update_time = time.time()

        return jsonify({"status": "connected"})

    except Exception as e:
        return jsonify({"status": "error", "message": str(e)})


def read_serial():
    global ser, last_values, last_update_time

    if ser is None or not ser.is_open:
        return

    try:
        line = ser.readline().decode().strip()
        if not line:
            return

        print("RAW:", line)

        parts = re.split(r'[,\s]+', line)

        if len(parts) < 10:
            return

        values = [float(x) for x in parts[:10]]

        last_values = values
        last_update_time = time.time()

    except Exception as e:
        print("Error:", e)


def serial_loop():
    while True:
        if ser and ser.is_open:
            read_serial()
        time.sleep(0.05)


threading.Thread(target=serial_loop, daemon=True).start()


@app.route('/data')
def get_data():
    global last_values, last_update_time

    if ser is None or not ser.is_open:
        return jsonify({"status": "disconnected"})

    if time.time() - last_update_time > 2:
        return jsonify({"status": "no_data"})

    p_volt = last_values[:5]
    t_volt = last_values[5:]

    p_psi = [round(v * 100, 2) for v in p_volt]
    t_temp = [round(v * 100, 2) for v in t_volt]

    return jsonify({
        "status": "live",
        **{f"p{i+1}_volt": p_volt[i] for i in range(5)},
        **{f"p{i+1}_psi": p_psi[i] for i in range(5)},
        **{f"t{i+1}_volt": t_volt[i] for i in range(5)},
        **{f"t{i+1}_temp": t_temp[i] for i in range(5)},
    })


if __name__ == "__main__":
    webbrowser.open("http://127.0.0.1:5000")
    app.run(port=5000, debug=False)
