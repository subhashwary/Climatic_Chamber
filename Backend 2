import webbrowser
from flask import Flask, jsonify, request, send_from_directory
from flask_cors import CORS
import serial
import time
import re

app = Flask(__name__)
CORS(app)

ser = None
last_values = [0.0] * 5


# ✅ SERVE FRONTEND
@app.route('/')
def serve_ui():
    return send_from_directory('.', 'index.html')


# ---------------- CONNECT ----------------
@app.route('/connect', methods=['POST'])
def connect():
    global ser

    data = request.json

    try:
        port = data.get("com_port")
        baud = int(data.get("baud_rate"))

        if not port or not baud:
            return jsonify({"status": "error", "message": "Missing COM port or baud rate"})

        if ser and ser.is_open:
            ser.close()
            time.sleep(1)

        ser = serial.Serial(port, baud, timeout=1)
        time.sleep(2)

        print(f"Connected to {port} at {baud}")
        return jsonify({"status": "connected"})

    except Exception as e:
        print("SERIAL ERROR:", e)
        return jsonify({"status": "error", "message": str(e)})


# ---------------- DATA ----------------
@app.route('/data')
def get_data():
    global ser, last_values

    if ser is None or not ser.is_open:
        return jsonify({
            "pressure": "Not Connected",
            **{f"p{i}_volt": "" for i in range(1, 6)},
            **{f"p{i}_psi": "" for i in range(1, 6)},
        })

    try:
        line = ser.readline().decode('utf-8', errors='ignore').strip()

        if not line:
            raise ValueError("Empty line")

        print("RAW:", line)

        # ✅ STRICT FORMAT: expect EXACTLY 5 values separated by commas or spaces
        parts = re.split(r'[,\s]+', line)

        if len(parts) != 5:
            print("Invalid packet (wrong length), ignored")
            raise ValueError("Bad packet")

        values = list(map(float, parts))

        # ✅ RANGE FILTER (adjust based on your sensors)
        for v in values:
            if v < 0 or v > 5:   # assuming voltage 0–5V
                print("Out of range value ignored:", v)
                raise ValueError("Noise detected")

        # ✅ SMOOTHING FILTER
        alpha = 0.8
        for i in range(5):
            last_values[i] = alpha * last_values[i] + (1 - alpha) * values[i]

        values = last_values.copy()

        psi_values = [round(v * 100, 3) for v in values]
        volt_values = [round(v, 3) for v in values]

        return jsonify({
            "pressure": "Live",
            "p1_volt": volt_values[0], "p1_psi": psi_values[0],
            "p2_volt": volt_values[1], "p2_psi": psi_values[1],
            "p3_volt": volt_values[2], "p3_psi": psi_values[2],
            "p4_volt": volt_values[3], "p4_psi": psi_values[3],
            "p5_volt": volt_values[4], "p5_psi": psi_values[4],
        })

    except Exception as e:
        print("READ ERROR:", e)

        # ✅ CRITICAL: flush corrupted buffer
        try:
            ser.reset_input_buffer()
        except:
            pass

        return jsonify({
            "pressure": "Stable",
            **{f"p{i}_volt": round(last_values[i-1], 3) for i in range(1, 6)},
            **{f"p{i}_psi": round(last_values[i-1] * 100, 3) for i in range(1, 6)},
        })

ser.reset_input_buffer()


# ---------------- START ----------------
@app.route('/start', methods=['POST'])
def start():
    print("START pressed")
    return jsonify({"status": "started"})


# ---------------- STOP ----------------
@app.route('/stop', methods=['POST'])
def stop():
    print("STOP pressed")
    return jsonify({"status": "stopped"})


# ---------------- RESET ----------------
@app.route('/reset', methods=['POST'])
def reset():
    global last_values
    last_values = [0.0] * 5
    print("RESET pressed")
    return jsonify({"status": "reset"})


# ---------------- RUN ----------------
if __name__ == "__main__":
    webbrowser.open("http://127.0.0.1:5000")
    app.run(host="127.0.0.1", port=5000, debug=False, use_reloader=False)
