import webbrowser
from flask import Flask, jsonify, request, send_from_directory
from flask_cors import CORS
import serial
import time
import re

app = Flask(__name__)
CORS(app)

ser = None
last_values = [0.0] * 5


# ✅ SERVE FRONTEND
@app.route('/')
def serve_ui():
    return send_from_directory('.', 'index.html')


# ---------------- CONNECT ----------------
@app.route('/connect', methods=['POST'])
def connect():
    global ser

    data = request.json

    try:
        port = data.get("com_port")
        baud = int(data.get("baud_rate"))

        if not port or not baud:
            return jsonify({"status": "error", "message": "Missing COM port or baud rate"})

        if ser and ser.is_open:
            ser.close()
            time.sleep(1)

        ser = serial.Serial(port, baud, timeout=1)

        time.sleep(2)  # Arduino reset
        ser.reset_input_buffer()  # ✅ VERY IMPORTANT

        print(f"Connected to {port} at {baud}")
        return jsonify({"status": "connected"})

    except Exception as e:
        print("SERIAL ERROR:", e)
        return jsonify({"status": "error", "message": str(e)})

# ---------------- DATA ----------------
@app.route('/data')
def get_data():
    global ser, last_values

    if ser is None or not ser.is_open:
        return jsonify({
            "pressure": "Not Connected",
            **{f"p{i}_volt": "" for i in range(1, 6)},
            **{f"p{i}_psi": "" for i in range(1, 6)},
        })

    try:
        line = ser.readline().decode('utf-8', errors='ignore').strip()

        if not line:
            raise ValueError("Empty line")

        print("RAW:", line)

        # ✅ Split values
        parts = re.split(r'[,\s]+', line)

        # ✅ STRICT FORMAT CHECK
        if len(parts) != 5:
            print("Rejected (wrong length)")
            raise ValueError("Invalid format")

        values = list(map(float, parts))

        # ✅ RANGE FILTER (0–5V)
        for v in values:
            if v < 0 or v > 5:
                print("Out of range:", v)
                raise ValueError("Noise")

        # ✅ SPIKE FILTER
        for i in range(5):
            if abs(values[i] - last_values[i]) > 2:
                print("Spike detected:", values[i])
                raise ValueError("Noise spike")

        # ✅ SMOOTHING
        alpha = 0.8
        for i in range(5):
            last_values[i] = alpha * last_values[i] + (1 - alpha) * values[i]

        values = last_values.copy()

        # ✅ CONVERSIONS
        psi_values = [round(v * 100, 3) for v in values]
        volt_values = [round(v, 3) for v in values]

        return jsonify({
            "pressure": "Live",
            **{f"p{i+1}_volt": volt_values[i] for i in range(5)},
            **{f"p{i+1}_psi": psi_values[i] for i in range(5)},
        })

    except Exception as e:
        print("READ ERROR:", e)

        # ✅ CLEAR BUFFER
        try:
            ser.reset_input_buffer()
        except:
            pass

        return jsonify({
            "pressure": "Stable",
            **{f"p{i+1}_volt": round(last_values[i], 3) for i in range(5)},
            **{f"p{i+1}_psi": round(last_values[i] * 100, 3) for i in range(5)},
        })

# ---------------- START ----------------
@app.route('/start', methods=['POST'])
def start():
    print("START pressed")
    return jsonify({"status": "started"})


# ---------------- STOP ----------------
@app.route('/stop', methods=['POST'])
def stop():
    print("STOP pressed")
    return jsonify({"status": "stopped"})


# ---------------- RESET ----------------
@app.route('/reset', methods=['POST'])
def reset():
    global last_values
    last_values = [0.0] * 5
    print("RESET pressed")
    return jsonify({"status": "reset"})


# ---------------- RUN ----------------
if __name__ == "__main__":
    webbrowser.open("http://127.0.0.1:5000")
    app.run(host="127.0.0.1", port=5000, debug=False, use_reloader=False)
